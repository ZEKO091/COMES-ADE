{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComesADE",
  "version": "0.1.4",
  "identifier": "com.comesade.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ComesADE",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#9a9b9a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* http://[::1]:* https://localhost:* https://127.0.0.1:* https://[::1]:* https://comesade-api.kingfrianfrian16.workers.dev ws://localhost:* ws://127.0.0.1:* ws://[::1]:* wss://localhost:* wss://127.0.0.1:* wss://[::1]:*; frame-src 'self' http://localhost:* http://127.0.0.1:* http://[::1]:* https://localhost:* https://127.0.0.1:* https://[::1]:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "shortDescription": "ADE local y Agent Super App",
    "longDescription": "ComesADE combina un entorno de desarrollo local con una Agent Super App para ejecutar agentes, shells, Git y previews reales.",
    "category": "DeveloperTool",
    "publisher": "ComesADE Project",
    "copyright": "Copyright © 2026 ComesADE Project",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ComesADE",
      "languages": ["Spanish"]
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {}
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxODg4Mjc5N0IyMUI2MUQKUldRZHRpRjdlWUtJUVNnZTZYckUxaVpzT3BwQ2hkZk0vQUFhSVhNK3JvbUlHL3pnTGJKMm1UUmMK",
      "endpoints": [
        "https://github.com/ZEKO091/COMES-ADE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
