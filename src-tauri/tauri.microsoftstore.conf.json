{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "digestAlgorithm": "sha256",
      "signCommand": "powershell.exe -NoProfile -NonInteractive -File ../scripts/sign-windows.ps1 -FilePath %1"
    }
  }
}
