{
  "name": "comesade-cloudflare-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check": "wrangler deploy --dry-run",
    "d1:migrate:local": "wrangler d1 migrations apply comesade-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply comesade-db --remote"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
