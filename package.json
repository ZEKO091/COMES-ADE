{
  "name": "comesade",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-vite.mjs",
    "dev:vite": "node scripts/dev-vite.mjs --once",
    "start": "node scripts/tauri.mjs dev",
    "dev:desktop": "node scripts/tauri.mjs dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "publish:desktop": "powershell.exe -NoProfile -NonInteractive -File scripts/publish-desktop.ps1",
    "publish:desktop:signed": "powershell.exe -NoProfile -NonInteractive -File scripts/publish-desktop.ps1 -RequireSignature",
    "release:desktop": "npm run tauri build && npm run publish:desktop",
    "release:desktop:signed": "npm run build:windows:signed && npm run publish:desktop:signed",
    "build:windows:signed": "powershell.exe -NoProfile -NonInteractive -File scripts/build-windows-signed.ps1",
    "build:windows:updater": "powershell.exe -NoProfile -NonInteractive -File scripts/build-windows-updater.ps1",
    "build:macos:signed": "bash scripts/build-macos-signed.sh",
    "build:macos:updater": "bash scripts/build-macos-updater.sh",
    "publish:macos": "bash scripts/publish-macos.sh",
    "release:macos": "npm run build:macos:updater && npm run publish:macos",
    "release:macos:signed": "npm run build:macos:signed && npm run publish:macos",
    "generate:updater-manifest": "node scripts/generate-updater-manifest.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0",
    "better-auth": "^1.7.1",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
